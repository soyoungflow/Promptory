# ─────────────────────────────
# Django 기본 설정
# ─────────────────────────────
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
# EC2 등: 서버 IP/도메인. Vercel 프록시 사용 시 *.vercel.app 도메인도 추가 (예: myapp.vercel.app)
# Vercel에 Django 배포 시 VERCEL_URL 은 자동 반영됨
ALLOWED_HOSTS=localhost,127.0.0.1

# ─────────────────────────────
# PostgreSQL (로컬 개발 — 필수)
# settings/__init__.py 가 config.settings.local 사용
# 로컬에 Postgres 실행 후 DB 생성 예:
#   createdb promptory_db
# ─────────────────────────────
DB_NAME=promptory_db
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_HOST=localhost
DB_PORT=5432
