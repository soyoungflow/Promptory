# ─────────────────────────────
# Django 기본 설정
# ─────────────────────────────
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
# EC2 Docker Compose: 공인 IP/도메인 포함 (예: 13.211.8.186)
# docker-compose.yml web 서비스가 이 값을 그대로 사용함
ALLOWED_HOSTS=localhost,127.0.0.1,web,13.211.8.186

# nginx 리버스 프록시 — Grafana/Prometheus 서브경로용 (프로토콜+호스트, 끝 슬래시 없음)
# EC2: http://13.211.8.186  /  로컬: http://localhost
PUBLIC_BASE_URL=http://13.211.8.186

# ─────────────────────────────
# PostgreSQL (로컬 개발 — 필수)
# settings/__init__.py 가 config.settings.local 사용
# 로컬에 Postgres 실행 후 DB 생성 예:
#   createdb promptory_db
# ─────────────────────────────
DB_NAME=promptory_db
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_HOST=localhost
DB_PORT=5432

# ─────────────────────────────
# Phase 4: Celery + Redis (EC2 Docker Compose)
# ─────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ─────────────────────────────
# Phase 4: FastAPI AI server
# ─────────────────────────────
FASTAPI_URL=http://ai_server:8000

# mock = 고정 mock JSON (외부 AI 미호출) | real = FastAPI/HuggingFace 추론
AI_MODE=mock

# real 모드 시 HF — docs/HF_EC2_SETUP.md
# EC2 2GB 검증용(안정): Qwen2.5-1.5B  /  프로젝트 명세 EXAONE: EXAONE-3.5-2.4B (8GB+)
HF_MODEL_NAME=Qwen/Qwen2.5-1.5B-Instruct
HF_EMBEDDING_MODEL=jhgan/ko-sroberta-multitask
HF_TORCH_DTYPE=float16
