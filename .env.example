# ─────────────────────────────
# Django 기본 설정
# ─────────────────────────────
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ─────────────────────────────
# PostgreSQL (로컬 개발 — 필수)
# settings/__init__.py 가 config.settings.local 사용
# 로컬에 Postgres 실행 후 DB 생성 예:
#   createdb promptory_db
# ─────────────────────────────
DB_NAME=promptory_db
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_HOST=localhost
DB_PORT=5432
